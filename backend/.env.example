# ==========================================
# MuMuAINovel PT-BR - exemplo de configuração
# ==========================================
# Copie este arquivo para .env e ajuste os valores:
# cp .env.example .env

# ==========================================
# Aplicação
# ==========================================
APP_NAME=MuMuAINovel
APP_VERSION=1.5.8
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TZ=America/Sao_Paulo

# ==========================================
# Banco de dados PostgreSQL
# ==========================================
POSTGRES_DB=mumuai_novel
POSTGRES_USER=mumuai
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# URL de conexão (gerada automaticamente no deploy com Docker)
# DATABASE_URL=postgresql+asyncpg://mumuai:123456@localhost:5432/mumuai_novel

# ==========================================
# Banco de dados SQLite (desenvolvimento local)
# ==========================================
# DATABASE_URL=sqlite+aiosqlite:///data/ai_story.db

# ==========================================
# Logs
# ==========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ==========================================
# Proxy global (opcional)
# ==========================================
# HTTP_PROXY=http://seu-proxy:porta
# HTTPS_PROXY=http://seu-proxy:porta
# NO_PROXY=localhost,127.0.0.1

# ==========================================
# Serviços de IA (configure ao menos um)
# ==========================================

# OpenAI
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_BASE_URL=https://api.openai.com/v1

# Configuração padrão de IA
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000

# LLM local / rede interna do Docker (Ollama, llama.cpp, host.docker.internal)
# Desligado por padrão para manter a proteção contra SSRF.
# Habilite apenas em máquina local ou rede confiável.
# ALLOW_PRIVATE_AI_ENDPOINTS=true
# ALLOWED_AI_HOSTS=host.docker.internal,127.0.0.1

# ==========================================
# Frontend
# ==========================================
FRONTEND_URL=http://localhost:8000

# ==========================================
# Login local (administrador)
# ==========================================
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=admin123
LOCAL_AUTH_DISPLAY_NAME=Administrador

# ==========================================
# Sessão
# ==========================================
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30
# Cookie de sessão Secure: vazio = automático conforme DEBUG; em deploy HTTP use false
# SESSION_COOKIE_SECURE=false

# ==========================================
# SMTP padrão (o administrador pode sobrescrever nas configurações do sistema)
# ==========================================
# Exemplos: Gmail (smtp.gmail.com, 587, TLS) ou Outlook (smtp.office365.com, 587, TLS)
SMTP_PROVIDER=custom
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MuMuAINovel
EMAIL_AUTH_ENABLED=true
EMAIL_REGISTER_ENABLED=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60
